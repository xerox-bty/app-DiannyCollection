<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".MonitorStockActivity">

    <!-- KONTEN UTAMA (DIKURUNG DALAM SCROLLVIEW & BERHENTI TEPAT DI ATAS BOTTOM NAV) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMonitorStock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavStock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- JUDUL HALAMAN: PANTAU STOK -->
            <TextView
                android:id="@+id/tvTitleMonitorStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="serif"
                android:text="Pantau Stok"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <!-- TAB FILTER KAPSUL (HABIS 3 | MENIPIS 7 | AMAN 118) -->
            <LinearLayout
                android:id="@+id/tabStockFilterContainer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/surface_beige"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineProvider="none"
                android:padding="4dp"
                android:weightSum="3">

                <!-- Tab 1: Habis 3 (Aktif) -->
                <TextView
                    android:id="@+id/tabStockOut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/primary_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:outlineProvider="none"
                    android:text="Habis 3"
                    android:textColor="@color/text_on_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Tab 2: Menipis 7 -->
                <TextView
                    android:id="@+id/tabStockLow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Menipis 7"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Tab 3: Aman 118 -->
                <TextView
                    android:id="@+id/tabStockSafe"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Aman 118"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CARD PUTIH DAFTAR STOK PRODUK -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStockList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- ================= ITEM STOK 1: SANDAL TEPLEK KULIT ================= -->
                    <LinearLayout
                        android:id="@+id/itemStock1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Thumbnail Produk -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                app:cardBackgroundColor="@color/thumb_gold"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp" />

                            <!-- Nama & Kode SKU -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStockName1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sandal Teplek Kulit"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStockSku1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="SDL-007"
                                    android:textColor="@color/text_hint"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Angka Sisa Stok (0) -->
                            <TextView
                                android:id="@+id/tvStockCount1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="0"
                                android:textColor="@color/status_red"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tombol + Restock Kanan Bawah -->
                        <TextView
                            android:id="@+id/btnRestock1"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_mode_live"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="+   Restock"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Garis Pemisah 1 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/surface_beige" />

                    <!-- ================= ITEM STOK 2: KEBAYA PUTIH POLOS ================= -->
                    <LinearLayout
                        android:id="@+id/itemStock2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                app:cardBackgroundColor="@color/thumb_maroon"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStockName2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Kebaya Putih Polos"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStockSku2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="KBY-020"
                                    android:textColor="@color/text_hint"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStockCount2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="0"
                                android:textColor="@color/status_red"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnRestock2"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_mode_live"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="+   Restock"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Garis Pemisah 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/surface_beige" />

                    <!-- ================= ITEM STOK 3: UDENG BATIK HITAM ================= -->
                    <LinearLayout
                        android:id="@+id/itemStock3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                app:cardBackgroundColor="@color/thumb_beige"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStockName3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Udeng Batik Hitam"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStockSku3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="IBD-011"
                                    android:textColor="@color/text_hint"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStockCount3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="0"
                                android:textColor="@color/status_red"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnRestock3"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_mode_live"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="+   Restock"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING BOTTOM NAVIGATION BAR (5 MENU ADMIN - STOK AKTIF) -->
    <LinearLayout
        android:id="@+id/bottomNavStock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="@color/primary_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Menu 1: Beranda -->
        <LinearLayout
            android:id="@+id/navStkHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Beranda"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 2: Produk -->
        <LinearLayout
            android:id="@+id/navStkProducts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Produk"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Produk"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 3: Catat -->
        <LinearLayout
            android:id="@+id/navStkRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/accent_gold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:outlineProvider="none"
                android:text="+"
                android:textColor="@color/primary_dark"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catat"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 4: Pesanan -->
        <LinearLayout
            android:id="@+id/navStkOrders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Pesanan"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pesanan"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 5: Stok (Aktif) -->
        <LinearLayout
            android:id="@+id/navStkStock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Stok"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/text_on_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stok"
                android:textColor="@color/text_on_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>