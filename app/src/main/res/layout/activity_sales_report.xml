<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".SalesReportActivity">

    <!-- KONTEN UTAMA (DIKURUNG DALAM SCROLLVIEW & BERHENTI TEPAT DI ATAS BOTTOM NAV) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSalesReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavReportOwner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- JUDUL HALAMAN: LAPORAN -->
            <TextView
                android:id="@+id/tvTitleReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="serif"
                android:text="Laporan"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <!-- TAB FILTER PERIODE (HARI INI | 7 HARI | BULAN INI) -->
            <LinearLayout
                android:id="@+id/tabReportFilterContainer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/surface_beige"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineProvider="none"
                android:padding="4dp"
                android:weightSum="3">

                <!-- Tab 1: Hari ini -->
                <TextView
                    android:id="@+id/tabReportToday"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Hari ini"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Tab 2: 7 Hari (Aktif) -->
                <TextView
                    android:id="@+id/tabReport7Days"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/primary_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:outlineProvider="none"
                    android:text="7 Hari"
                    android:textColor="@color/text_on_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Tab 3: Bulan ini -->
                <TextView
                    android:id="@+id/tabReportMonth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Bulan ini"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CARD UTAMA GELAP: TOTAL PENJUALAN & GRAFIK BATANG 7 HARI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalSalesChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/primary_dark"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="TOTAL PENJUALAN TERKONFIRMASI"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="serif"
                        android:text="Rp 8.450.000"
                        android:textColor="@color/text_on_dark"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRevenueTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="▲ 12% dari minggu lalu"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp" />

                    <!-- DIAGRAM BATANG (SEN - MIN) -->
                    <LinearLayout
                        android:id="@+id/chartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <!-- Hari 1: Sen -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barMon"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Sen"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 2: Sel -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barTue"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Sel"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 3: Rab -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barWed"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Rab"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 4: Kam -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barThu"
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Kam"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 5: Jum -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barFri"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Jum"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 6: Sab (Tertinggi / Highlight Emas) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barSat"
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Sab"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Hari 7: Min -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/barSun"
                                android:layout_width="match_parent"
                                android:layout_height="68dp"
                                android:layout_marginHorizontal="4dp"
                                app:cardBackgroundColor="@color/accent_gold_light"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Min"
                                android:textColor="@color/text_hint"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BARIS 2 CARD RINGKASAN: PESANAN & TERKONFIRMASI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card Kiri: Pesanan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pesanan"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvReportTotalOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="serif"
                            android:text="96"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Kanan: Terkonfirmasi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terkonfirmasi"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvReportConfirmedOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="serif"
                            android:text="71"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SEKSI: PRODUK TERLARIS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Produk terlaris"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- CARD ITEM PRODUK TERLARIS 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBestSeller1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBestSellerName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kaos Barong Bali"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBestSellerSku1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="KOS-021"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBestSellerCount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38 terjual"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING BOTTOM NAVIGATION BAR (4 MENU OWNER - LAPORAN AKTIF) -->
    <LinearLayout
        android:id="@+id/bottomNavReportOwner"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="@color/primary_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="none"
        android:paddingHorizontal="12dp"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Menu 1: Beranda -->
        <LinearLayout
            android:id="@+id/navRepHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Beranda"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Beranda"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 2: Pesanan -->
        <LinearLayout
            android:id="@+id/navRepOrders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Pesanan"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Pesanan"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 3: Stok -->
        <LinearLayout
            android:id="@+id/navRepStock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Stok"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Stok"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Menu 4: Laporan (Aktif) -->
        <LinearLayout
            android:id="@+id/navRepReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Laporan"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/text_on_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Laporan"
                android:textColor="@color/text_on_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>